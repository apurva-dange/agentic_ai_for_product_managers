# --mode single-agent (default) and --mode coordinator run entirely on a
# deterministic local mock model and need NO API key.
#
# --mode live requires a real OpenRouter API key below. Copy this file to
# `.env` (already gitignored) and put your real key there - never commit a
# real key, and never pass it on the command line.
OPENROUTER_API_KEY=your-openrouter-api-key-here
